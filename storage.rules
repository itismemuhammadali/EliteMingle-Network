rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Posts media storage path: posts/{userId}/{postId}/{fileName}
    match /posts/{userId}/{postId}/{allPaths=**} {
      // Dev/emulator: allow public read so RN <Image> (which sends no auth token)
      // can load post media. Tighten before production.
      allow read: if true;

      // Allow upload/write if user is authenticated and path matches auth.uid
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Profile avatars: avatars/{userId}/{fileName}
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}

