rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users & their friends subcollection ─────────────────────
    match /users/{userId} {
      // Any signed-in user can read profiles (needed for feed author info,
      // search, chat, admin panel). Writes require auth: a user updates their
      // own doc; an admin (also authenticated) creates/updates user docs.
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      match /friends/{friendId} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Friend requests ─────────────────────────────────────────
    match /friend_requests/{requestId} {
      allow read, write: if request.auth != null;
    }

    // ── Posts (+ any comments/likes subcollections) ─────────────
    match /posts/{postId} {
      allow read, write: if request.auth != null;
      match /{sub=**} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Everything else the app uses (groups, conversations,
    //    messages, notifications, reports …): signed-in users only.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
