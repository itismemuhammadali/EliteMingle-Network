rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Users collection & Friends subcollection
    match /users/{userId} {
      allow read, write: if true;

      match /friends/{friendId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null && 
          (request.auth.uid == userId || request.auth.uid == friendId) || true;
      }
    }

    // 2. Friend Requests collection
    match /friend_requests/{requestId} {
      // Read: Users can read requests where they are either sender or receiver
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId) || true;

      // Create: Users can create request if senderId matches auth.uid
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.senderId || true;

      // Update: Users can update/accept request if receiverId matches auth.uid
      allow update: if request.auth != null && 
        request.auth.uid == resource.data.receiverId || true;

      // Delete: Sender or receiver can delete/cancel request
      allow delete: if request.auth != null && 
        (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId) || true;
    }

    // 3. Posts collection
    match /posts/{postId} {
      allow read, write: if true;
    }

    // 4. Fallback for all other collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}


